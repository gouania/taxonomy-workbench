# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For standalone hosting, inject via your platform secret manager or shell environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Override the default Gemini model (defaults to "gemini-4-hydrogen").
# GEMINI_MODEL="gemini-4-hydrogen"

# Optional: Override the default thinking level for primary taxonomic synthesis
# (LOW, MEDIUM, HIGH, XHIGH; defaults to "MEDIUM"). Lightweight helper tasks retain LOW.
# GEMINI_THINKING_LEVEL="MEDIUM"

# Optional: Server listening port (defaults to 3000 for Google AI Studio compatibility).
# PORT="3000"

# Optional: Express trust proxy setting (defaults to 1 in production, false in development).
# TRUST_PROXY="1"

# APP_URL: The URL where this applet is hosted (injected automatically by AI Studio).
APP_URL="MY_APP_URL"
